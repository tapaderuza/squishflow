<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is the app's own ground from the first frame. A stock light
         theme drew a white flash before Compose painted the dark screen, which
         is the wrong first impression for a product built on calm. -->
    <style name="Theme.Squishflow" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
